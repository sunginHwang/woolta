{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    // baseUrl 은 TS7 에서 제거됐다. paths 는 이 파일(레포 루트) 기준 상대경로로 해석된다.
    "paths": {
      "@article-curations/features": ["./libs/article-curations/features/src/index.ts"],
      "@article-curations/screens": ["./libs/article-curations/screens/src/index.ts"],
      "@blog/features": ["./libs/blog/features/src/index.ts"],
      "@calendar/features": ["./libs/calendar/features/src/index.ts"],
      "@calendar/screens": ["./libs/calendar/screens/src/index.ts"],
      "@blog/screens": ["./libs/blog/screens/src/index.ts"],
      "@common": ["./libs/common/src/index.ts"],
      "@common/graphql": ["./libs/common/src/lib/utils/graphqlFetch.ts"],
      "@memo/features": ["./libs/memo/features/src/index.ts"],
      "@memo/screens": ["./libs/memo/screens/src/index.ts"],
      "@todo/features": ["./libs/todo/features/src/index.ts"],
      "@todo/screens": ["./libs/todo/screens/src/index.ts"],
      "@user/features": ["./libs/user/features/src/index.ts"],
      "@common/server": ["./libs/common/src/server.ts"],
      "@common/test": ["./libs/common/test/src/index.ts"],
      "@wds": ["./libs/wds/src/index.ts"],
      "@wds/*": ["./libs/wds/src/lib/style/*"],
      "@woolbank/features": ["./libs/woolbank/features/src/index.ts"],
      "@woolbank/screens": ["./libs/woolbank/screens/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
