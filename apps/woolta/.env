NEXT_PUBLIC_BANK_API=https://bank-api.woolta.com
NEXT_PUBLIC_BANK_API_BROWSER=/api/bank
NEXT_PUBLIC_BLOG_API=https://api-blog.woolta.com
NEXT_PUBLIC_BLOG_API_BROWSER=/api/blog
NEXT_PUBLIC_IMAGE_API=https://image.woolta.com

# woolta-api(GraphQL) 호스트.
# 브라우저는 프록시 경로(next.config.js rewrites: /api/gql)를 타므로 CORS 없이 쿠키가 전달된다.
# 이 값은 **빌드 시점에 번들로 인라인**된다 — 바꾸면 재빌드해야 한다.
# 비우면 NEXT_PUBLIC_BLOG_API(레거시 Spring)로 폴백해 GraphQL 이 404 가 난다.
NEXT_PUBLIC_GRAPHQL_API=https://api.woolta.com
NEXT_PUBLIC_GRAPHQL_API_BROWSER=/api/gql

# 소셜 로그인 provider 공개 키. 값이 없으면 해당 버튼이 비활성화된다.
# 서버(woolta-api)에도 GOOGLE_CLIENT_ID / KAKAO_APP_ID 가 있어야 로그인이 성립한다.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=922918112483-2p3e9084urmsn3fkfptekave3h9t3i3d.apps.googleusercontent.com
NEXT_PUBLIC_KAKAO_JS_KEY=d35244b490fa1937d657994fc0f70b60
