NEXT_PUBLIC_SETTING_THEME=SETTING_THEME
NEXT_PUBLIC_ACCESS_TOKEN=_WOOLTA_USER_
NEXT_PUBLIC_ACCESS_PUSH_TOKEN=_WOOLTA_PUSH__
NEXT_PUBLIC_ACCESS_HEADER_TOKEN=Authorization
NEXT_PUBLIC_BLOG_API=https://api-blog.woolta.com

# woolta-api(GraphQL) 호스트.
# 브라우저는 프록시 경로(next.config.js rewrites)를 타므로 CORS 없이 쿠키가 전달된다.
# 이 값은 **빌드 시점에 번들로 인라인**된다 — 바꾸면 재빌드해야 한다.
# 비우면 NEXT_PUBLIC_BLOG_API(레거시 Spring)로 폴백해 /blog/graphql 이 404 가 난다.
NEXT_PUBLIC_GRAPHQL_API=https://api.woolta.com
NEXT_PUBLIC_GRAPHQL_API_BROWSER=/api/gql

NEXT_PUBLIC_IMAGE_API=https://image.woolta.com
NEXT_PUBLIC_BLOG_URL=https://blog.woolta.com
# 로그인은 .woolta.com 공용 세션을 쓴다 — 소셜 로그인 화면으로 위임한다.
NEXT_PUBLIC_LOGIN_URL=https://bank.woolta.com/user/login

NEXT_PUBLIC_TEMP_POST_AUTO_SAVE=TEMP_POST_AUTO_SAVE
NEXT_PUBLIC_BLOG_THUMBNAIL_IMAGE_URL=https://image.woolta.com/3fed2d102ca753c6.png
NEXT_PUBLIC_PWA_LOG=[WOOLTA_BLOG_SERVICE_WORKER];
PORT=8091
