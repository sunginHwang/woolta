NEXT_PUBLIC_BANK_API=https://bank-api.woolta.com


# woolta-api(GraphQL) 호스트.
# 브라우저는 프록시 경로(next.config.js rewrites)를 타므로 CORS 없이 쿠키가 전달된다.
# 이 값은 **빌드 시점에 번들로 인라인**된다 — 바꾸면 재빌드해야 한다.
# 비우면 NEXT_PUBLIC_BANK_API(레거시 Koa)로 폴백해 /woolBank/graphql 이 404 가 난다.
NEXT_PUBLIC_GRAPHQL_API=https://api.woolta.com
NEXT_PUBLIC_GRAPHQL_API_BROWSER=/api/gql

# Web Push VAPID 공개키(base64url). 서버(/etc/woolta/api.env)의 WOOLBANK_VAPID_PUBLIC_KEY 와 같은 값.
# 빌드 시점에 번들로 인라인된다 — 바꾸면 재빌드. 비우면 마이페이지의 알림 설정 섹션이 아예 렌더되지 않는다(설정 문제를 사용자에게 "지원 안 함" 으로 보여주지 않는다).
NEXT_PUBLIC_WOOLBANK_VAPID_PUBLIC_KEY=BNbKq3p9cNaC-vwfU7AEDpJoB9a3VNWDu68hWCOGLSPGOscBejOXLeG9ll4p_qijGeF87-I1ylHlQAZvlmRA6sQ
