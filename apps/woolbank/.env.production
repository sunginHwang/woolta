NEXT_PUBLIC_BANK_API=https://bank-api.woolta.com


# woolta-api(GraphQL) 호스트. 레거시 Koa(NEXT_PUBLIC_BANK_API)와 다른 서버라 변수를 나눈다.
# 브라우저는 프록시 경로(next.config.js rewrites)를 타므로 CORS 없이 쿠키가 전달된다.
# 배포 전에 NEXT_PUBLIC_GRAPHQL_API 를 반드시 채운다 — 비어 있으면 레거시 호스트로 폴백해
# /woolBank/graphql 이 404 가 난다.
# NEXT_PUBLIC_GRAPHQL_API=
NEXT_PUBLIC_GRAPHQL_API_BROWSER=/api/gql
