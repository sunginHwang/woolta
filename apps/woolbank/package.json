{
  "name": "woolbank",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4200",
    "build": "next build",
    "start": "next start",
    "test": "vitest run --passWithNoTests",
    "storybook": "storybook dev -p 4400 -c .storybook",
    "build-storybook": "storybook build -o ../../dist/storybook/woolbank -c .storybook",
    "test-storybook": "pnpm -w exec vitest run --project storybook-woolbank",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.storybook.json"
  },
  "dependencies": {
    "@woolta/common": "workspace:*",
    "@woolta/wds": "workspace:*"
  }
}
