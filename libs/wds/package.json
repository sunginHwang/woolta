{
  "name": "@woolta/wds",
  "version": "0.0.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "storybook": "storybook dev -p 4600 -c .storybook",
